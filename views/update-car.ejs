<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Car Details</title>
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body>

    <%- include('./partials/navbar')  %>

    <h1>Update Car Details</h1>
        
    <form action="/cars/<%= car._id %>?_method=PUT" method="post">
        <div class="form-input-section">
            <label for="make">Make: </label>
            <input id="make" type="text" name="make" value="<%= car.make %>">

            <label for="model">Model: </label>
            <input type="text" id="model" name="model" value="<%= car.model %>">

            <label for="year">Year: </label>
            <input type="number" id="year" name="year" value="<%= car.year %>">

            <label for="plateNumber">Plate NUmber: </label>
            <input type="text" id="plateNumber" name="plateNumber" value="<%= car.plateNumber %>">

            <label for="engineType">Engine Type: </label>
            <input type="text" id="engineType" name="engineType" value="<%= car.engineType %>">
            
            <label for="carImage">Car Img URL: </label>
            <input type="text" id="carImage" name="carImage">

            <div class="reg-input">
                <label for="isRegistered">Registered: </label>
                <input type="checkbox" id="isRegistered" name="isRegistered" <% if (car.isRegistered) {%>checked<%} %> >
            </div>
            
            <button>Update Car</button>
        </div>
    </form>
</body>
</html>