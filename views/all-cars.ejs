<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Cars</title>
    <link rel="stylesheet" href="./assets/style.css">
</head>
<body>
    <%- include('./partials/navbar')  %>
    <h1>All Cars</h1>
    <div class="cars-container">
    <% for( oneCar of cars) { %>
        <div class="car-box">
            <p><b>Car Make:</b> <%= oneCar.make %></p>
            <p><b>Car Model:</b> <%= oneCar.model %></p>
            <p><b>Car Year:</b> <%= oneCar.year %></p>
            <p><b>Plate Number:</b> <%= oneCar.plateNumber %></p>
            <p><b>Engine Type:</b> <%= oneCar.engineType %></p>
            <% if (oneCar.isRegistered == false) { %>
                <p><b>Registeration Status: </b>Not Registered</p>
            <% } else if (oneCar.isRegistered === true) { %>
                <p><b>Registeration Status: </b>Registered</p>
            <% } %>
            <a href="/cars/<%= oneCar._id %>/update">
            <button>
                Update Car
            </button>
            </a>

            <form action="/cars/<%= oneCar._id%>?_method=DELETE" method="post">
                <button>Delete Car</button>
            </form>
        </div>
    <% } %>
    </div>
</body>
</html>